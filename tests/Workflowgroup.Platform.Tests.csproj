<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA2007;CA1062;CA1822;NU1900;NU1603;IDE0055</NoWarn>
    <RootNamespace>Workflowgroup.Platform.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="[10.0.1, 10.1.0)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.8.1, 18.9.0)" />
    <PackageReference Include="NSubstitute" Version="[6.0.0, 6.1.0)" />
    <PackageReference Include="xunit" Version="[2.9.3, 2.10.0)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.5, 3.2.0)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Workflowgroup.Platform.csproj" />
  </ItemGroup>
</Project>
